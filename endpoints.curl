# ==============================================================================
# Flash Booking API - cURL Collection for Postman Import
# Base URL: http://localhost:8080
# ==============================================================================

# 1. Create Event (POST /events)
curl --location --request POST 'http://localhost:8080/events' \
--header 'Content-Type: application/json' \
--data-raw '{
  "name": "Rock in Rio 2026 - Flash Sale",
  "totalSeats": 100
}'

# 2. Get Event by ID (GET /events/{eventId})
curl --location --request GET 'http://localhost:8080/events/00000000-0000-0000-0000-000000000001'

# 3. Get Event Availability (GET /events/{eventId}/availability)
curl --location --request GET 'http://localhost:8080/events/00000000-0000-0000-0000-000000000001/availability'

# 4. Reserve Tickets with Idempotency-Key (POST /events/{eventId}/reservations)
curl --location --request POST 'http://localhost:8080/events/00000000-0000-0000-0000-000000000001/reservations' \
--header 'Content-Type: application/json' \
--header 'Idempotency-Key: a1b2c3d4-e5f6-7890-abcd-ef1234567890' \
--data-raw '{
  "customerId": "customer-123",
  "quantity": 2
}'

# 5. Get Reservation by ID (GET /reservations/{reservationId})
curl --location --request GET 'http://localhost:8080/reservations/00000000-0000-0000-0000-000000000002'

# 6. Confirm Reservation (POST /reservations/{reservationId}/confirm)
curl --location --request POST 'http://localhost:8080/reservations/00000000-0000-0000-0000-000000000002/confirm'

# 7. Cancel Reservation (DELETE /reservations/{reservationId})
curl --location --request DELETE 'http://localhost:8080/reservations/00000000-0000-0000-0000-000000000002'

# 8. Actuator Health Check (GET /actuator/health)
curl --location --request GET 'http://localhost:8080/actuator/health'

# 9. OpenAPI JSON Spec (GET /v3/api-docs)
curl --location --request GET 'http://localhost:8080/v3/api-docs'
